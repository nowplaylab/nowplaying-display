<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nowplaylab.nowplaying"
    android:versionCode="26"
    android:versionName="2.4">

    <!-- targetSdk 34: новые Android (15+) не ставят приложения со старым targetSdk. Код по-прежнему
         собирается против API 17, всё новое — через проверку версии -->
    <uses-sdk android:minSdkVersion="16" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- обновление приложения без root: окно установки (Android 8+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- убрать старую версию приложения (до 2.4 у него было другое имя пакета) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+: без этого старое приложение не видно и его нельзя найти, чтобы убрать -->
    <queries>
        <package android:name="com.tab3.nowplaying" />
    </queries>
    <!-- Android TV: экрана касаний нет, но ставиться можно; на планшетах ничего не меняется -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="Сейчас играет"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ApkProvider"
            android:authorities="com.nowplaylab.nowplaying.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- заставка: Настройки → Заставка → «Сейчас играет» (Android 4.2+, на планшете — во время зарядки) -->
        <service
            android:name=".NowPlayingDream"
            android:label="Сейчас играет"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
